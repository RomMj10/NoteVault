{
  "manifest_version": 2,
  "name": "NoteVault",
  "version": "1.0.2",
  "description": "Capture notes, images, and ideas directly in your browser and sync them securely across devices using cloud storage.",
  "content_security_policy": "script-src 'self'; connect-src https://firestore.googleapis.com https://*.googleapis.com https://api.cloudinary.com; img-src 'self' data: blob: https:; object-src 'self'",

  "data_collection_permissions": {
    "required": [],
    "optional": []
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "NoteVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "web_accessible_resources": [
    "icons/*.png"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": [
    "storage",
    "https://firestore.googleapis.com/*",
    "https://api.cloudinary.com/*",
    "tabs"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "notevault@local.extension",
      "strict_min_version": "109.0"
    }
  }
}
