{
  "manifest_version": 2,
  "name": "NoteVault",
  "version": "1.0.2",
  "description": "Take notes and store them in the cloud.",
  "content_security_policy": "script-src 'self'; img-src 'self' data: blob: https:; object-src 'self'",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "NoteVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "web_accessible_resources": [
    "icons/*.png",
    "popup.css",
    "popup.js",
    "popup.html"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "permissions": [
    "storage",
    "https://firestore.googleapis.com/*",
    "https://api.cloudinary.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "notevault@local.extension",
      "strict_min_version": "109.0"
    }
  }
}
